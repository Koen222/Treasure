{% comment %}
  Mixer Catch pop-up for Willow Haven.
  Add as a Custom Liquid section (or paste into theme.liquid before </body>).
  Shows the game in a modal after a short delay, once per visitor, and closes
  when the game says so (close button, "No thanks", "Continue shopping").
{% endcomment %}
{%- assign mc_game_url = section.settings.game_url | default: 'https://illustrious-dodol-168f5f.netlify.app/catch/' -%}
{%- assign mc_delay = section.settings.delay_seconds | default: 8 -%}
{%- assign mc_days = section.settings.days_between | default: 14 -%}

<div id="mc-popup" class="mc-popup" hidden role="dialog" aria-modal="true" aria-label="Catch for a discount">
  <div class="mc-popup__scrim" data-mc-close></div>
  <div class="mc-popup__frame">
    <iframe id="mc-popup-frame" title="Mixer Catch game" loading="lazy" allow="clipboard-write"></iframe>
  </div>
</div>

<style>
  .mc-popup { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .mc-popup[hidden] { display: none; }
  .mc-popup__scrim { position: absolute; inset: 0; background: rgba(35, 31, 32, 0.55); }
  .mc-popup__frame { position: relative; width: min(400px, 100%); height: min(760px, calc(100dvh - 32px)); border-radius: 22px; overflow: hidden; box-shadow: 0 18px 50px rgba(59,35,20,.35); }
  .mc-popup__frame iframe { width: 100%; height: 100%; border: 0; background: transparent; display: block; }
</style>

<script>
  (function () {
    var KEY = 'mc_popup_seen';
    var DAYS = {{ mc_days }};
    var DELAY = {{ mc_delay }} * 1000;
    var URL = {{ mc_game_url | json }};
    var popup = document.getElementById('mc-popup');
    var frame = document.getElementById('mc-popup-frame');
    if (!popup || !frame) return;

    function seen() {
      try { var t = +localStorage.getItem(KEY) || 0; return Date.now() - t < DAYS * 864e5; } catch (e) { return false; }
    }
    function markSeen() { try { localStorage.setItem(KEY, String(Date.now())); } catch (e) {} }
    function open() {
      if (!frame.src) frame.src = URL;
      popup.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      markSeen();
    }
    function close() {
      popup.hidden = true;
      document.documentElement.style.overflow = '';
    }

    if (!seen()) setTimeout(open, DELAY);

    popup.addEventListener('click', function (e) { if (e.target.hasAttribute('data-mc-close')) close(); });
    window.addEventListener('message', function (e) {
      if (e.data && e.data.type === 'mixercatch:close') close();
    });
    window.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !popup.hidden) close(); });

    // Optional: open on demand from any link with href="#play"
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a[href="#play"]');
      if (a) { e.preventDefault(); open(); }
    });
  })();
</script>

{% schema %}
{
  "name": "Mixer Catch pop-up",
  "settings": [
    { "type": "url", "id": "game_url", "label": "Game URL", "info": "Where the game is hosted (Netlify)." },
    { "type": "range", "id": "delay_seconds", "label": "Open after (seconds)", "min": 0, "max": 60, "step": 1, "default": 8 },
    { "type": "range", "id": "days_between", "label": "Days before showing again", "min": 1, "max": 90, "step": 1, "default": 14 }
  ],
  "presets": [{ "name": "Mixer Catch pop-up" }]
}
{% endschema %}
